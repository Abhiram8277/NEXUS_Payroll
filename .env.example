# NEXUS Payroll Platform Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_payroll?schema=public"
JWT_SECRET="nexus_super_secret_jwt_key_2026_enterprise_payroll"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# ========================================================
# EMAIL / SMTP CONFIGURATION
# ========================================================
# Option 1: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
#
# NOTE FOR GMAIL USERS:
# You must use a 16-character Google App Password, not your regular password.
# Create one at: https://myaccount.google.com/apppasswords
#
# Option 2: Brevo / SendGrid / Mailgun / AWS SES / Office365
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NEXUS Payroll <no-reply@nexuspayroll.in>"
