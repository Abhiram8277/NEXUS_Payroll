{
  "name": "nexus-payroll",
  "version": "1.0.0",
  "description": "NEXUS — Payroll, without the paperwork.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:start": "node scripts/start-db.js",
    "dev": "concurrently \"npm run db:start\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "build:backend": "npm run prisma:generate && npm --workspace=backend run build",
    "start:backend": "node backend/dist/server.js",
    "test": "npm --workspace=backend test",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "prisma:seed": "node scripts/run-seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
